# Copy to .env.local (local dev) and add the same variables in Vercel → Project → Settings → Environment Variables.

# Public URL of the site (canonical URLs, sitemap, hreflang, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.srilankaexpotours.com

# ── Booking emails (SMTP) ─────────────────────────────────────────────
# Any SMTP provider works. Examples:
#   Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  (use an App Password, not your normal password)
#   Zoho Mail:                SMTP_HOST=smtp.zoho.com   SMTP_PORT=465
#   Brevo:                    SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=465
# true for port 465, false for 587 (defaults automatically from the port if left empty)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Sender shown to guests — must be an address your SMTP account may send as
MAIL_FROM="SriLanka Expo Tours <info@srilankaexpotours.com>"

# Inbox that receives new booking notifications (defaults to the email in lib/site.ts)
BOOKING_NOTIFY_TO=info@srilankaexpotours.com

# ── Optional ──────────────────────────────────────────────────────────
# Every booking is also POSTed as JSON here (Zapier / Make / n8n / HubSpot / Airtable).
BOOKING_WEBHOOK_URL=
